rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidSong(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.artist is string && data.artist.size() > 0 && data.artist.size() <= 200 &&
             data.youtubeUrl is string && data.youtubeUrl.size() > 0 && data.youtubeUrl.size() <= 500 &&
             (!('midiUrl' in data) || (data.midiUrl is string && data.midiUrl.size() <= 1000)) &&
             (!('sheetUrl' in data) || (data.sheetUrl is string && data.sheetUrl.size() <= 1000));
    }

    match /songs/{songId} {
      // Anyone can view piano tutorials in the catalog
      allow read: if true;
      // Admin writes validated song entries
      allow create, update: if isValidSong(request.resource.data);
      allow delete: if true;
    }
  }
}
